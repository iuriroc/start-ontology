NODE_ENV=development

API_PORT=3001

POSTGRES_USER=ontology
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ontology
# If port 5432 on your machine is already taken by another Postgres, set
# POSTGRES_HOST_PORT and match it here (docker-compose.yml maps it in).
DATABASE_URL=postgresql://ontology:change-me@localhost:5433/ontology

CORS_ORIGIN=http://localhost:5173

# Optional hardening
RATE_LIMIT_MAX=200
RATE_LIMIT_WINDOW=1 minute
BODY_LIMIT_BYTES=1048576

# Frontend (Vite) — never put secrets here, this is exposed to the browser
VITE_API_URL=http://localhost:3001
